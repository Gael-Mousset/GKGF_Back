// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Maker {
  Nintendo
  Sega
  Sony
  Microsoft
}

enum Pegi {
  Pegi_3
  Pegi_7
  Pegi_12
  Pegi_16
  Pegi_18
}

enum Edition_Game {
  Black_Label
  Platinum
  Collector
  Limited
  Game_of_the_Year
  Special_Edition
  Nintendo_Select
}

enum Region {
  EUR
  PAL
  NTSC
  NTSC_Japan
}

enum All_Support {
  All_Support
  Partial_Support
  No_Support
}

enum Language {
  English
  French
  German
  Italian
  Spanish
  Japanese
  Chinese
  Korean
}

enum Type_Accessoire {
  Controller
  PowerSupply
  Memory
  VideoOutput
  Other
}

enum Etat {
  New
  Like_New
  Very_Good
  Good
  Acceptable
  Poor
  For_Part
}

model User {
  id         Int          @id @default(autoincrement())
  name       String
  email      String       @unique
  password   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  game       Game[]
  console    Console[]
  accessoire Accessoire[]
}

model Plateform {
  name       String       @id
  maker      Maker
  resources  Resource?
  idResource Int?         @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  game       Game[]
  console    Console[]
  accessoire Accessoire[]
}

model Resource {
  id             Int      @id @default(autoincrement())
  url            String   @unique @db.VarChar(255)
  mimetype       String   @db.VarChar(20)
  PlateformeName String?  @unique
  gameId         Int?
  consoleId      Int?
  accessoireId   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  game       Game?       @relation(fields: [gameId], references: [id])
  console    Console?    @relation(fields: [consoleId], references: [id])
  plateform  Plateform?  @relation(fields: [PlateformeName], references: [name], onDelete: Cascade)
  accessoire Accessoire? @relation(fields: [accessoireId], references: [id], onDelete: Cascade)
}

model Game {
  id             Int          @id @default(autoincrement())
  title          String       @db.VarChar(255)
  PlateformeName String
  serial_number  String       @db.VarChar(20)
  excusivity     Boolean      @default(false)
  Pegi           Pegi
  edition        Edition_Game @default(Black_Label)
  region         Region       @default(PAL)
  language       Language     @default(French)
  inBox          Boolean      @default(false)
  manual         Boolean      @default(false)
  All_Support    All_Support  @default(All_Support)
  etat           Etat         @default(New)
  collection     Boolean      @default(false)
  throws         Boolean      @default(false)
  resources      Resource[]
  description    String
  UserId         Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plateformeName Plateform @relation(fields: [PlateformeName], references: [name])
  user           User      @relation(fields: [UserId], references: [id])
}

model Console {
  id             Int        @id @default(autoincrement())
  title          String     @db.VarChar(255)
  plateformeName String
  edition        String
  serial_number  String     @db.VarChar(50)
  region         Region     @default(PAL)
  manual         Boolean    @default(false)
  inBox          Boolean    @default(false)
  allItems       Boolean    @default(false)
  etat           Etat       @default(New)
  throw          Boolean    @default(false)
  collection     Boolean    @default(false)
  resources      Resource[]
  description    String     @db.VarChar(255)
  userId         Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  plateforme Plateform @relation(fields: [plateformeName], references: [name])
  user       User      @relation(fields: [userId], references: [id])
}

model Accessoire {
  id             Int             @id @default(autoincrement())
  nom            String          @db.VarChar(255)
  plateformeName String
  type           Type_Accessoire @default(Controller)
  modele         String          @db.VarChar(255)
  etat           Etat            @default(New)
  operates       Boolean         @default(false)
  collection     Boolean         @default(false)
  resources      Resource[]
  description    String          @db.VarChar(255)
  userId         Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  plateforme Plateform @relation(fields: [plateformeName], references: [name])
  user       User      @relation(fields: [userId], references: [id])
}

