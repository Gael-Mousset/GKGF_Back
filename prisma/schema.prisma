generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Maker {
  Nintendo
  Sega
  Sony
  Microsoft
}

enum Audience_Rating {
  All
  Pegi_3
  Pegi_7
  Pegi_12
  Pegi_16
  Pegi_18
}

enum Edition_Game {
  Black_Label
  Platinum
  Collector
  Limited
  Game_of_the_Year
  Special_Edition
  Nintendo_Select
}

enum Signal {
  PAL
  NTSC
  NTSC_Japan
}

enum Region {
  EUR
  US
  JAP
  Multiple
}

enum All_Support {
  All_Support
  Partial_Support
  No_Support
}

enum Language {
  English
  French
  German
  Italian
  Spanish
  Japanese
  Chinese
  Korean
}

enum Type_Accessoire {
  Controller
  PowerSupply
  Memory
  VideoOutput
  Other
}

enum Status {
  in_progress
  in_ligne
  done
}

enum Format {
  Cartouche
  Cassette
  Disquette
  CD
  DVD
  BluRay
}

enum Etat {
  non_defini
  neuf
  tres_bon
  bon
  moyen
  mauvais
  tres_mauvais
  hors_serie
}

enum Contenu {
  non_defini
  sous_blister
  complet
  jeux_seule
  boite_seule
  manuel_seule
  boite_manuel_seule
  jaquette_manquante
  jeux_boite
  jeux_manuel
}

enum Objectif {
  non_defini
  vendre
  garder
  completer
  remplacer
  reparer
}

enum launch_status {
  WORKING
  PARTIAL
  NOT_WORKING
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game       Game[]
  console    Console[]
  accessoire Accessoire[]
  annonce    Annonce[]
}

model Plateform {
  id Int @id @default(autoincrement())

  name  String
  maker Maker

  resources Resource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game       Game[]
  console    Console[]
  accessoire Accessoire[]
}

model Series {
  id   Int    @id @default(autoincrement())
  name String
  game Game[]
}

model Editions {
  id   Int    @id @default(autoincrement())
  name String
  game Game[]
}

model Location {
  id   Int    @id @default(autoincrement())
  name String
  game Game[]
}

model Resource {
  id           Int      @id @default(autoincrement())
  url          String   @unique @db.VarChar(255)
  mimetype     String   @db.VarChar(20)
  plateformeId Int?     @unique
  gameId       Int?
  consoleId    Int?
  accessoireId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game       Game?       @relation(fields: [gameId], references: [id])
  console    Console?    @relation(fields: [consoleId], references: [id])
  plateform  Plateform?  @relation(fields: [plateformeId], references: [id], onDelete: Cascade)
  accessoire Accessoire? @relation(fields: [accessoireId], references: [id], onDelete: Cascade)
}

model Game {
  id        Int    @id @default(autoincrement())
  //Infos 
  title     String @db.VarChar(255)
  idSeries  Int
  sortTitle String @db.VarChar(255)

  //info boite
  plateformeId  Int
  serial_number String @db.VarChar(20)
  barcode       String @db.VarChar(20)
  format        Format @default(DVD)

  // info version
  idEdition  Int
  region     Region          @default(EUR)
  signal     Signal          @default(PAL)
  audience   Audience_Rating @default(All)
  language   Language        @default(French)
  excusivity Boolean         @default(false)

  // info contenu
  jeux       Boolean       @default(false)
  boite      Boolean       @default(false)
  manuel     Boolean       @default(false)
  etatJeu    Etat          @default(non_defini)
  launch     launch_status @default(WORKING)
  etatbox    Etat          @default(non_defini)
  etatManuel Etat          @default(non_defini)

  // objectif de la version 
  objectif   Objectif @default(non_defini)
  idLocation Int

  // images
  resources Resource[]

  //description
  description String @db.Text

  // links externes
  userId    Int
  annonceId Int?

  // infos creation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vente Vente?

  series     Series    @relation(fields: [idSeries], references: [id])
  plateforme Plateform @relation(fields: [plateformeId], references: [id])
  editions   Editions  @relation(fields: [idEdition], references: [id])
  location   Location  @relation(fields: [idLocation], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  annonce    Annonce?  @relation(fields: [annonceId], references: [id])
}

model Console {
  id            Int        @id @default(autoincrement())
  title         String     @db.VarChar(255)
  plateformeId  Int
  edition       String
  serial_number String     @db.VarChar(50)
  region        Region     @default(EUR)
  manual        Boolean    @default(false)
  inBox         Boolean    @default(false)
  allItems      Boolean    @default(false)
  etat          Etat       @default(non_defini)
  throw         Boolean    @default(false)
  collection    Boolean    @default(false)
  resources     Resource[]
  description   String     @db.VarChar(255)
  userId        Int
  annonceId     Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  vente Vente?

  plateform Plateform @relation(fields: [plateformeId], references: [id])
  annonce   Annonce?  @relation(fields: [annonceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Accessoire {
  id           Int             @id @default(autoincrement())
  nom          String          @db.VarChar(255)
  plateformeId Int
  type         Type_Accessoire @default(Controller)
  modele       String          @db.VarChar(255)
  etat         Etat            @default(non_defini)
  operates     Boolean         @default(false)
  collection   Boolean         @default(false)
  resources    Resource[]
  description  String          @db.VarChar(255)
  userId       Int
  annonceId    Int?

  vente Vente?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plateforme Plateform @relation(fields: [plateformeId], references: [id])
  annonce    Annonce?  @relation(fields: [annonceId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model Vente {
  id          Int      @id @default(autoincrement())
  prix_achat  Float
  date_achat  DateTime
  prix_estime Float

  gameId       Int? @unique
  consoleId    Int? @unique
  accessoireId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game       Game?       @relation(fields: [gameId], references: [id])
  console    Console?    @relation(fields: [consoleId], references: [id])
  accessoire Accessoire? @relation(fields: [accessoireId], references: [id], onDelete: Cascade)
}

model Annonce {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  userId      Int
  prix_vente  Int
  status      Status
  prux_vendu  Int
  date_vente  DateTime
  urlVinted   String
  urlLBC      String

  games       Game[]
  consoles    Console[]
  accessoires Accessoire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])
}

